{
  "name": "easy-prompt",
  "version": "0.1.0",
  "description": "A cross-platform desktop app to write and manage AI prompts.",
  "author": "EasyPrompt",
  "license": "MIT",
  "main": "./out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev --noSandbox",
    "build": "unset ELECTRON_RUN_AS_NODE && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:mac": "electron-vite build && electron-builder --mac --arm64",
    "preview": "electron-vite preview --noSandbox"
  },
  "build": {
    "appId": "com.easyprompt.app",
    "productName": "EasyPrompt",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon-256.png",
      "build/icon-tray-32.png",
      "!**/.pnpm-store",
      "!**/.dev-data",
      "!**/node_modules/.cache"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/search": "^6.5.10",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "i18next": "^23.16.5",
    "markdown-it": "^14.2.0",
    "react-i18next": "^15.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
